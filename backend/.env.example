NODE_ENV=development
PORT=5001
MONGODB_URI=mongodb://localhost:27017/VolunteerConnect
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173
TZ=Asia/Kuala_Lumpur

# Optional Cloudinary configuration for avatar and resume uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional EmailJS configuration. Email notifications are skipped when unset.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID_STATUS=
EMAILJS_TEMPLATE_ID_OPPORTUNITY=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAIL_NOTIFICATION_SUPPRESS_RECIPIENTS=
